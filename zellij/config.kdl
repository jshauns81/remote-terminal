// Zellij config for the nexus web terminal. The browser chrome is the real UI,
// so Zellij's own tab/status bars are stripped in the layout; this file sets
// the theme, the tab-switch bridge keybinds, and quiet defaults.

// Tokyo Night (night variant), in Zellij's 0.43+ component theme format.
// The old flat-palette format made Zellij 0.44 derive the mouse-selection
// background from `black`, so selected text turned near-black and invisible.
// text_selected below is that highlight: Tokyo Night's selection blue
// (#3d59a1) behind light text. The same colour is used by the xterm theme in
// nexus.js, Claude Code's custom theme (selectionBg) -- one look in every tab.
theme "nexus"
themes {
    nexus {
        text_unselected {
            base 192 202 245
            background 26 27 38
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        text_selected {
            base 192 202 245
            background 61 89 161
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        ribbon_unselected {
            base 65 72 104
            background 169 177 214
            emphasis_0 247 118 142
            emphasis_1 192 202 245
            emphasis_2 122 162 247
            emphasis_3 187 154 247
        }
        ribbon_selected {
            base 65 72 104
            background 158 206 106
            emphasis_0 247 118 142
            emphasis_1 255 158 100
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        table_title {
            base 158 206 106
            background 0
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        table_cell_unselected {
            base 192 202 245
            background 26 27 38
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        table_cell_selected {
            base 192 202 245
            background 51 70 124
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        list_unselected {
            base 192 202 245
            background 26 27 38
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        list_selected {
            base 192 202 245
            background 51 70 124
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 158 206 106
            emphasis_3 187 154 247
        }
        frame_unselected {
            base 65 72 104
            background 0
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 187 154 247
            emphasis_3 0
        }
        frame_selected {
            base 122 162 247
            background 0
            emphasis_0 255 158 100
            emphasis_1 125 207 255
            emphasis_2 187 154 247
            emphasis_3 0
        }
        frame_highlight {
            base 255 158 100
            background 0
            emphasis_0 187 154 247
            emphasis_1 255 158 100
            emphasis_2 255 158 100
            emphasis_3 255 158 100
        }
        exit_code_success {
            base 158 206 106
            background 0
            emphasis_0 125 207 255
            emphasis_1 65 72 104
            emphasis_2 187 154 247
            emphasis_3 122 162 247
        }
        exit_code_error {
            base 247 118 142
            background 0
            emphasis_0 224 175 104
            emphasis_1 0
            emphasis_2 0
            emphasis_3 0
        }
        multiplayer_user_colors {
            player_1 187 154 247
            player_2 122 162 247
            player_3 125 207 255
            player_4 224 175 104
            player_5 158 206 106
            player_6 255 158 100
            player_7 247 118 142
            player_8 169 177 214
            player_9 192 202 245
            player_10 65 72 104
        }
    }
}

default_layout "nexus"
pane_frames false
simplified_ui true
show_startup_tips false
show_release_notes false
// Off: its modifier+click "select this pane for a group action" gesture
// competes with xterm's macOptionClickForcesSelection bypass for the exact
// same click, so text selection could never win. Nothing else in nexus
// uses pane grouping (every tab is a single full-pane), so this is free.
advanced_mouse_actions false

// Tab-switch bridge (Phase 0, Path B): the HTML tab bar writes these byte
// sequences over the websocket and Zellij switches tab directly — no mode
// flash. Bound in shared_except "locked" so `Ctrl g` (locked mode) is the
// passthrough escape hatch if an app ever needs Alt+digit itself.
keybinds {
    shared_except "locked" {
        bind "Alt 1" { GoToTab 1; }
        bind "Alt 2" { GoToTab 2; }
        bind "Alt 3" { GoToTab 3; }
        bind "Alt 4" { GoToTab 4; }
    }
}
