// Generated from server/tools.js. Edit tool targets there.
layout {
    default_tab_template { children; }
    tab name="claude" {
        pane command="node" {
            args "/app/server/launch-tool.js" "claude";
            close_on_exit false
        }
    }
    tab name="host" {
        pane command="node" {
            args "/app/server/launch-tool.js" "host";
            close_on_exit false
        }
    }
    tab name="opencode" {
        pane command="node" {
            args "/app/server/launch-tool.js" "opencode";
            close_on_exit false
        }
    }
    tab name="llm" {
        pane command="node" {
            args "/app/server/launch-tool.js" "llm";
            close_on_exit false
        }
    }
}
